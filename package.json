{
  "name": "authon-worker",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development next dev -H 0.0.0.0 -p 3000",
    "dev:reset": "rm -rf .wrangler && npm run db:migrate:local && npm run dev",
    "build": "cross-env NODE_ENV=production next build",
    "prebuild:worker": "npm run check:sensitive-assets -- --skip-assets",
    "build:worker": "opennextjs-cloudflare build",
    "postbuild:worker": "npm run check:sensitive-assets && npm run check:worker-artifact",
    "deploy:dev": "node scripts/ops/require-development-intent.mjs && wrangler deploy --env dev",
    "deploy:prod": "node scripts/ops/require-production-intent.mjs && npm run build:worker && opennextjs-cloudflare deploy",
    "cf:preview": "opennextjs-cloudflare preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "npm run test:auth && npm run test:request && npm run test:user-policy && npm run test:external-link-policy && npm run test:offline-door && npm run test:connectors && npm run test:guest-bulk && npm run test:internal-sync && npm run test:events && npm run test:closeout && npm run test:rate-limit && npm run test:date && npm run test:observability && npm run test:sensitive-assets && npm run test:ops",
    "test:i18n": "node --test scripts/check-i18n.test.mjs && node scripts/check-i18n.mjs",
    "test:dom": "node --import tsx --import ./test/dom/setup.mjs --test test/dom/*.test.tsx",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:dom && npm run test:i18n && npm run check:sensitive-assets -- --skip-assets && npm run check:migrations",
    "verify:release": "npm run verify && npm run build && npm run build:worker",
    "test:date": "node --experimental-strip-types --test lib/date.test.mjs",
    "test:request": "node --experimental-strip-types --test lib/latest-request.test.mjs lib/polling-coordinator.test.mjs lib/route-loading.test.mjs lib/route-transition-events.test.mjs lib/guest-snapshot-policy.test.mjs lib/admin-navigation.test.mjs lib/guests/display-order.test.mjs lib/guests/request-section-state.test.mjs lib/ui/async-list-state.test.mjs lib/forms/immutable-draft.test.mjs lib/api/domain-error.test.mjs",
    "test:user-policy": "node --experimental-strip-types --test lib/users/policy.test.mjs",
    "test:external-link-policy": "node --experimental-strip-types --test lib/external-links/domain.test.mjs lib/external-links/ownership.test.mjs lib/external-links/ownership-sql.test.mjs lib/external-links/schema.test.mjs",
    "test:offline-door": "node --experimental-strip-types --test lib/door/offline-domain.test.mjs lib/door/offline-sync.test.mjs",
    "test:connectors": "node --experimental-strip-types --test lib/connectors/policy.test.mjs",
    "test:guest-bulk": "node --experimental-strip-types --test lib/guests/bulk-entry.test.mjs lib/guests/csv-import.test.mjs lib/guests/atomic-sql.test.mjs",
    "test:internal-sync": "node --experimental-strip-types --test lib/internal-sync/terminal-guest-sync.test.mjs",
    "test:events": "node --experimental-strip-types --test lib/events/domain.test.mjs lib/events/schema.test.mjs lib/events/template.test.mjs lib/guests/activity-ledger.test.mjs scripts/migration/event-backfill-plan.test.mjs",
    "test:closeout": "node --experimental-strip-types --test lib/closeout/domain.test.mjs lib/closeout/schema.test.mjs lib/closeout/sql.test.mjs",
    "test:rate-limit": "node --experimental-strip-types --test lib/auth/rate-limit-policy.test.mjs",
    "test:observability": "node --experimental-strip-types --test lib/observability/structured-log.test.mjs lib/observability/server-log-source.test.mjs",
    "test:auth": "node --experimental-strip-types --test lib/auth/client-session.test.mjs lib/auth/cookie-policy.test.mjs lib/auth/first-login-policy.test.mjs lib/auth/request-origin.test.mjs lib/auth/password-reset-receipt.test.mjs lib/auth/password-reset-request-policy.test.mjs lib/auth/password-reset-request-sql.test.mjs lib/auth/password-reset-lifecycle-sql.test.mjs lib/auth/credential-lifecycle-sql.test.mjs lib/auth/user-profile.test.mjs lib/tenant/active-policy.test.mjs scripts/dev/local-test-password.test.mjs",
    "check:sensitive-assets": "node scripts/check-sensitive-assets.mjs",
    "test:sensitive-assets": "node --test scripts/check-sensitive-assets.test.mjs",
    "test:ops": "node --test scripts/ops/require-development-intent.test.mjs scripts/ops/development-environment.test.mjs scripts/ops/require-production-intent.test.mjs scripts/migration/check-authority.test.mjs scripts/check-worker-artifact.test.mjs",
    "check:migrations": "node scripts/migration/check-authority.mjs",
    "check:worker-artifact": "node scripts/check-worker-artifact.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply authon-db --local",
    "db:migrate:remote": "node scripts/ops/require-production-intent.mjs && wrangler d1 migrations apply authon-db --remote",
    "db:backfill:events:dry-run": "node scripts/migration/dry-run-event-backfill.mjs",
    "migration:export:supabase": "node scripts/migration/export-supabase-snapshot.mjs",
    "migration:verify:snapshot": "node scripts/migration/verify-supabase-snapshot.mjs",
    "migration:verify:cutover": "cross-env ALLOW_RECONCILED_GUEST_COUNTS=1 node scripts/migration/verify-supabase-snapshot.mjs",
    "migration:generate:d1-import": "node scripts/migration/generate-d1-import-sql.mjs",
    "migration:generate:cutover-overlays": "node scripts/migration/generate-cutover-overlays.mjs",
    "db:seed:local": "node scripts/dev/seed-local-test-data.mjs"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.85.0",
    "@carbon/react": "^1.113.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.45.2",
    "jose": "^5.9.6",
    "next": "^16.2.12",
    "next-intl": "^4.13.4",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.2",
    "sass": "^1.102.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260727.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "jsdom": "30.0.1",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.17",
    "tsx": "4.23.12",
    "typescript": "^5",
    "wrangler": "^4.122.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.0",
    "form-data": "4.0.6",
    "js-yaml": "4.3.1",
    "minimatch": "10.2.5",
    "brace-expansion": "5.0.9",
    "nanoid": "3.3.18",
    "esbuild": "0.28.1"
  }
}
