{
  "name": "authon-worker",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "cross-env NODE_ENV=development next dev -H 0.0.0.0 -p 3000",
    "dev:reset": "rm -rf .wrangler && npm run db:migrate:local && npm run dev",
    "build": "cross-env NODE_ENV=production next build",
    "build:worker": "opennextjs-cloudflare build --config=wrangler.demo.toml",
    "deploy": "npm run deploy:demo",
    "deploy:demo": "opennextjs-cloudflare build --config=wrangler.demo.toml && opennextjs-cloudflare deploy --config=wrangler.demo.toml",
    "cf:preview": "opennextjs-cloudflare preview --config=wrangler.demo.toml",
    "lint": "eslint .",
    "test:date": "node --experimental-strip-types --test lib/date.test.mjs",
    "test:demo": "node --experimental-strip-types --test lib/demo/*.test.mjs",
    "test:request": "node --experimental-strip-types --test lib/latest-request.test.mjs",
    "test:user-policy": "node --experimental-strip-types --test lib/users/policy.test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply authon-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply authon-db --remote",
    "migration:export:supabase": "node scripts/migration/export-supabase-snapshot.mjs",
    "migration:verify:snapshot": "node scripts/migration/verify-supabase-snapshot.mjs",
    "migration:verify:cutover": "cross-env ALLOW_RECONCILED_GUEST_COUNTS=1 node scripts/migration/verify-supabase-snapshot.mjs",
    "migration:generate:d1-import": "node scripts/migration/generate-d1-import-sql.mjs",
    "migration:generate:cutover-overlays": "node scripts/migration/generate-cutover-overlays.mjs",
    "db:seed:local": "node scripts/dev/seed-local-test-data.mjs"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.85.0",
    "@carbon/react": "^1.113.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@swc/helpers": "0.5.23",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.45.2",
    "jose": "^5.9.6",
    "next": "^16.2.12",
    "next-intl": "^4.13.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.2",
    "sass": "^1.102.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260727.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "wrangler": "^4.114.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.0",
    "form-data": "4.0.6",
    "minimatch": "10.2.5",
    "brace-expansion": "5.0.8",
    "esbuild": "0.28.1"
  }
}
