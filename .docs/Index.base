filters:
  and:
    - file.inFolder(".docs")
    - file.ext == "md"
formulas:
  days_old: (now() - file.ctime).days
properties:
  tags:
    displayName: Tags
  formula.days_old:
    displayName: Days Old
views:
  - type: table
    name: Documentation Index
    order:
      - file.name
      - tags
      - formula.days_old
      - file.mtime
